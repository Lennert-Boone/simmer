# Supabase — te vinden in je project onder Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google Gemini — gratis sleutel via https://aistudio.google.com/apikey
# Dit is de gedeelde terugvalsleutel. Een gezin kan in de app een eigen sleutel
# (Gemini of Anthropic) invullen; die wint dan van deze.
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.6-flash

# Optioneel: foto's bij gerechten. Gratis sleutel via https://www.pexels.com/api
# Zonder deze sleutel toont de receptpagina gewoon geen foto.
PEXELS_API_KEY=

# Basis-URL van de app, gebruikt in de redirect na inloggen
NEXT_PUBLIC_SITE_URL=http://localhost:3000
