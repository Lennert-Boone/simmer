# Supabase — te vinden in je project onder Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google Gemini — gratis sleutel via https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Optioneel: overschrijf het model. Flash-modellen zitten in de gratis laag.
GEMINI_MODEL=gemini-3.6-flash

# Basis-URL van de app, gebruikt in de redirect na inloggen
NEXT_PUBLIC_SITE_URL=http://localhost:3000
